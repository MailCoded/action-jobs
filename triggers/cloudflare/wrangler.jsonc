{
  "name": "oracle-a1-trigger",
  "main": "src/index.mjs",
  "compatibility_date": "2026-05-25",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "GITHUB_REPOSITORY": "MailCoded/action-jobs",
    "WORKFLOW": "oracle-a1.yml",
    "REF": "main",
    // In a single-AD region a negative capacity report would skip the only launch attempt.
    "INPUTS": { "capacity_check": "false", "try_fault_domains": "true" }
  },
  "observability": {
    "enabled": true
  }
}
